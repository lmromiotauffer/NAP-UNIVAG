{
  "name": "nap-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "api:gerar": "openapi-typescript ../backend/openapi.json -o src/lib/api-schema.d.ts",
    "api:check": "node scripts/verificar-contrato.mjs",
    "e2e": "playwright test",
    "verificar": "npm run api:check && tsc -b --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@fontsource/red-hat-display": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.0",
    "axios": "1.20.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
