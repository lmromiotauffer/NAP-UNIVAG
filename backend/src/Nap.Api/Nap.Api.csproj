<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- OpenAPI gerado no build em backend/openapi.json (o entry point roda sem tocar SQL nem Redis) -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../..</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <UserSecretsId>38adba2f-b9e5-472e-afca-f26e24c70eea</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- necessário para `dotnet ef` usar a Api como projeto de inicialização -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nap.Application\Nap.Application.csproj" />
    <ProjectReference Include="..\Nap.Infrastructure\Nap.Infrastructure.csproj" />
  </ItemGroup>
</Project>
